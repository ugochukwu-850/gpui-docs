---
import Figure from './Figure.astro';
import Defs from './Defs.astro';
---
<Figure caption="<strong>The loop every GPUI app runs.</strong> You change data and call <code>cx.notify()</code>. GPUI calls <code>render</code> again and redraws the window. Solid outlines are code you write; dashed outlines are work GPUI does for you.">
<svg class="dg" viewBox="0 0 700 352" role="img" aria-label="The GPUI loop: your data is read by render, which builds an element tree. GPUI draws it into the window. A user click calls your handler, which changes the data and calls cx.notify, which starts the loop again.">
	<Defs />

	<path class="ed" d="M172 81 H267" />
	<path class="ed" d="M432 81 H527" />
	<path class="ed dash" d="M610 128 V207" />
	<path class="ed dash" d="M528 255 H433" />
	<path class="ed dash" d="M268 255 H173" />
	<path class="ed acc" d="M90 207 V128" />

	<text class="lbl" x="220" y="71" text-anchor="middle">read by</text>
	<text class="lbl" x="480" y="71" text-anchor="middle">builds</text>
	<text class="lbl" x="620" y="172">GPUI draws</text>
	<text class="lbl" x="480" y="245" text-anchor="middle">user clicks</text>
	<text class="lbl" x="220" y="245" text-anchor="middle">calls your code</text>
	<text class="lbl acc" x="101" y="163">changes the data,</text>
	<text class="lbl acc" x="101" y="181">then cx.notify()</text>

	<text class="big" x="350" y="160" text-anchor="middle">You never edit the screen.</text>
	<text class="big" x="350" y="184" text-anchor="middle">You change the data.</text>

	<rect class="nd state" x="10" y="36" width="160" height="92" rx="12" />
	<text class="ttl" x="28" y="68">Your data</text>
	<text class="sub mono" x="28" y="90">count: i32</text>
	<text class="sub" x="28" y="110">a field on your struct</text>

	<rect class="nd view" x="270" y="36" width="160" height="92" rx="12" />
	<text class="ttl" x="288" y="68">render()</text>
	<text class="sub" x="288" y="90">reads your data</text>
	<text class="sub" x="288" y="110">describes the UI</text>

	<rect class="nd element" x="530" y="36" width="160" height="92" rx="12" />
	<text class="ttl" x="548" y="68">Element tree</text>
	<text class="sub mono" x="548" y="90">div() text button</text>
	<text class="sub" x="548" y="110">rebuilt every frame</text>

	<rect class="nd platform dash" x="530" y="209" width="160" height="92" rx="12" />
	<text class="ttl" x="548" y="241">Window</text>
	<text class="sub" x="548" y="263">pixels on screen</text>
	<text class="sub" x="548" y="283">drawn on the GPU</text>

	<rect class="nd dash" x="270" y="209" width="160" height="92" rx="12" />
	<text class="ttl" x="288" y="241">User input</text>
	<text class="sub" x="288" y="263">a click or key press</text>
	<text class="sub" x="288" y="283">lands in the window</text>

	<rect class="nd view" x="10" y="209" width="160" height="92" rx="12" />
	<text class="ttl" x="28" y="241">Your handler</text>
	<text class="sub mono" x="28" y="263">on_click(..)</text>
	<text class="sub" x="28" y="283">changes this.count</text>

	<g>
		<circle class="bd state" cx="10" cy="36" r="12" /><text class="bn" x="10" y="36">1</text>
		<circle class="bd view" cx="270" cy="36" r="12" /><text class="bn" x="270" y="36">2</text>
		<circle class="bd element" cx="530" cy="36" r="12" /><text class="bn" x="530" y="36">3</text>
		<circle class="bd platform" cx="530" cy="209" r="12" /><text class="bn" x="530" y="209">4</text>
		<circle class="bd neutral" cx="270" cy="209" r="12" /><text class="bn" x="270" y="209">5</text>
		<circle class="bd view" cx="10" cy="209" r="12" /><text class="bn" x="10" y="209">6</text>
	</g>

	<g transform="translate(10 332)">
		<rect class="nd" x="0" y="-8" width="24" height="16" rx="4" /><text class="sub" x="32" y="4">code you write</text>
		<rect class="nd dash" x="140" y="-8" width="24" height="16" rx="4" /><text class="sub" x="172" y="4">GPUI does this</text>
		<rect class="sw state" x="320" y="-6" width="12" height="12" rx="3" /><text class="sub" x="338" y="4">state</text>
		<rect class="sw view" x="392" y="-6" width="12" height="12" rx="3" /><text class="sub" x="410" y="4">view</text>
		<rect class="sw element" x="460" y="-6" width="12" height="12" rx="3" /><text class="sub" x="478" y="4">elements</text>
		<rect class="sw platform" x="566" y="-6" width="12" height="12" rx="3" /><text class="sub" x="584" y="4">screen</text>
	</g>
</svg>
</Figure>
